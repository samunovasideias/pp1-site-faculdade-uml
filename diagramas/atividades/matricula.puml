@startuml
title Portal Acadêmico da Faculdade - Atividade de matrícula
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF4FF
  BorderColor #245B83
  DiamondBackgroundColor #FFF2CC
  DiamondBorderColor #B7791F
  ArrowColor #435466
}

|Aluno|
start
:Escolher período e disciplinas;
|Portal Acadêmico|
:Validar pré-requisitos, vagas e conflitos de horário;
while (Regras atendidas?) is (não)
  :Exibir pendências da seleção;
  |Aluno|
  :Corrigir disciplinas;
  |Portal Acadêmico|
  :Revalidar matrícula;
endwhile (sim)
|Aluno|
:Confirmar matrícula;
|Portal Acadêmico|
:Registrar matrícula e gerar protocolo;
:Exibir confirmação ao aluno;
stop

legend bottom
  Responsável pela modelagem: Samuel
  Referência no quadro: cartão 36 - refinar diagrama de atividades do processo de matrícula
endlegend
@enduml
