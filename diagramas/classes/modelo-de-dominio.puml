@startuml
title Portal Acadêmico da Faculdade - Modelo de domínio
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam class {
  BackgroundColor #F4F8FC
  BorderColor #245B83
  ArrowColor #435466
}
skinparam linetype ortho

abstract class Usuario {
  id: UUID
  nome: texto
  email: texto
  status: StatusUsuario
}
class Aluno {
  matricula: texto
}
class Professor {
  registro: texto
}
class Secretaria {
  setor: texto
}
class Curso {
  id: UUID
  codigo: texto
  nome: texto
}
class Disciplina {
  id: UUID
  codigo: texto
  nome: texto
  cargaHoraria: inteiro
}
class Turma {
  id: UUID
  periodo: texto
  status: StatusTurma
}
class Matricula {
  id: UUID
  data: data
  status: StatusMatricula
}
class Nota {
  id: UUID
  etapa: texto
  valor: decimal
  publicadaEm: dataHora
}
class EventoAcademico {
  id: UUID
  titulo: texto
  inicio: dataHora
  fim: dataHora
}
class Aviso {
  id: UUID
  titulo: texto
  publicadoEm: dataHora
  status: StatusAviso
}

Usuario <|-- Aluno
Usuario <|-- Professor
Usuario <|-- Secretaria

Curso "1" *-- "1..*" Disciplina : compõe
Disciplina "1" -- "0..*" Turma : é ofertada em
Professor "1" -- "0..*" Turma : ministra
Aluno "1" -- "0..*" Matricula : realiza
Turma "1" -- "0..*" Matricula : recebe
Matricula "1" *-- "0..*" Nota : reúne
Professor "1" -- "0..*" Nota : registra
Secretaria "1" -- "0..*" EventoAcademico : mantém
Secretaria "1" -- "0..*" Aviso : publica

note bottom
  Responsável pela modelagem: Andrei Albuquerque
  Referência no quadro: cartão 38 - conferir tipos e restrições dos atributos das classes
end note
@enduml
